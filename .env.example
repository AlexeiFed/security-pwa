# Firebase Configuration
# Получите эти значения в консоли Firebase: https://console.firebase.google.com/
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Yandex Maps API
# Получите ключ на: https://developer.tech.yandex.ru/
REACT_APP_YANDEX_MAPS_API_KEY=your_yandex_maps_key_here

# CallDog API Configuration
# Получите ключи на: https://call-dog.ru/
REACT_APP_CALLDOG_API_KEY=your_call_dog_api_key_here
REACT_APP_CALLDOG_OUTGOING_PHONE=+7XXXXXXXXXX

# Push Notifications
# VAPID ключи для push-уведомлений
REACT_APP_VAPID_PUBLIC_KEY=your_vapid_public_key_here
REACT_APP_PUSH_SERVER_URL=https://your-push-server.com

# OneSignal Configuration (если используется)
REACT_APP_ONESIGNAL_APP_ID=your_onesignal_app_id_here
